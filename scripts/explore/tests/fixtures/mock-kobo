#!/usr/bin/env python3
"""A stand-in for `mock-kobo serve`, for the Kobo lane's tests.

Speaks the part of the real binary's contract the lane depends on: the flags,
the token in `OMNIBUS_MOCK_KOBO_TOKEN`, a state file that records the origin and
keeps the hardware id across restarts, the `MOCK_KOBO_READY` line, and the
control API's reply envelope. `GET /__calls` lists the control requests it got.
`STUB_MOCK_KOBO_MODE` picks a behaviour: `ok` (default), `crash` (exit before
READY), `stubborn` (ignore SIGTERM), `sync_failed` (every sync fails),
`foreign_ready` (a READY line for another process comes first).
"""

import json
import os
import signal
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

BOOK = {
    "title": "Stub Book",
    "description": "",
    "authors": ["Stub Author"],
    "series": None,
    "downloaded": True,
    "archived": False,
}
BOOK_ID = "0f1e2d3c-4b5a-6978-8a9b-0c1d2e3f4a5b"


def flags(argv):
    pairs = dict(zip(argv[1::2], argv[2::2]))
    return pairs["--url"], pairs["--state"], int(pairs["--port"])


def hardware_id(state_path):
    try:
        with open(state_path) as handle:
            return json.load(handle)["device"]["hardware_id"]
    except (OSError, ValueError, KeyError):
        return "mock-" + os.urandom(16).hex()


class Handler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        return

    def reply(self, status, code, message, details):
        self.send_json(status, {"status": status, "code": code, "message": message, "details": details})

    def send_json(self, status, payload):
        body = json.dumps(payload).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        self.route("GET")

    def do_POST(self):
        self.route("POST")

    def route(self, method):
        stub = self.server.stub
        if (method, self.path) == ("GET", "/__calls"):
            return self.send_json(200, stub["calls"])
        stub["calls"].append([method, self.path])
        if (method, self.path) == ("GET", "/device"):
            view = {**stub["device"], "url": stub["url"], "syncing": False, "last_sync": stub["last_sync"]}
            return self.reply(200, "ok", "ok", view)
        if (method, self.path) == ("POST", "/actions/sync"):
            return self.sync(stub)
        if (method, self.path) == ("GET", "/requests"):
            return self.reply(200, "ok", "ok", {"requests": stub["requests"]})
        self.reply(404, "not_found", f"no route for {method} {self.path}", {})

    def sync(self, stub):
        if stub["mode"] == "sync_failed":
            message = "GET /v1/user/profile answered 404"
            stub["last_sync"] = {"result": "failed", "quirk": "StorePaths", "message": message}
            stub["requests"] = [{"method": "GET", "path": "/kobo/[REDACTED]/v1/user/profile", "status": 404}]
            return self.reply(502, "sync_failed", message, {"quirk": "StorePaths"})
        stub["device"]["library"][BOOK_ID] = dict(BOOK)
        stub["last_sync"] = {"result": "synced", "pages": 1}
        stub["requests"] = [{"method": "GET", "path": "/kobo/[REDACTED]/v1/library/sync", "status": 200}]
        self.reply(200, "synced", "sync complete", {"pages": 1})


def main(argv):
    mode = os.environ.get("STUB_MOCK_KOBO_MODE", "ok")
    if mode == "crash":
        print("mock-kobo: cannot bind 127.0.0.1:0 (stub crash)", file=sys.stderr)
        return 1
    url, state_path, port = flags(argv)
    device = {"hardware_id": hardware_id(state_path), "library": {}, "sync_token": None}
    state = {"url": url, "token": os.environ["OMNIBUS_MOCK_KOBO_TOKEN"], "device": device, "argv": argv, "pid": os.getpid()}
    with open(state_path, "w") as handle:
        json.dump(state, handle)
    server = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    server.stub = {"mode": mode, "url": url, "device": device, "last_sync": None, "requests": [], "calls": []}
    if mode == "stubborn":
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
    ready = f"MOCK_KOBO_READY port={server.server_port} hardware_id={device['hardware_id']} state={state_path} pid={os.getpid()}"
    if mode == "foreign_ready":
        print(f"MOCK_KOBO_READY port=1 hardware_id=mock-foreign state={state_path} pid=1", flush=True)
    print(ready, flush=True)
    server.serve_forever()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
