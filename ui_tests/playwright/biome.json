{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**/*.ts", "!test-results", "!playwright-report"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": [
        "tests/**/*.spec.ts",
        "!tests/flows/account.spec.ts",
        "!tests/flows/add_books.spec.ts",
        "!tests/flows/add_books_sheet.spec.ts",
        "!tests/flows/admin_health.spec.ts",
        "!tests/flows/api_tokens.spec.ts",
        "!tests/flows/auth.spec.ts",
        "!tests/flows/author_delete.spec.ts",
        "!tests/flows/author_photo.spec.ts",
        "!tests/flows/book_delete.spec.ts",
        "!tests/flows/book_detail.spec.ts",
        "!tests/flows/book_detail_chips.spec.ts",
        "!tests/flows/book_detail_shelves.spec.ts",
        "!tests/flows/book_url_stability.spec.ts",
        "!tests/flows/boot.spec.ts",
        "!tests/flows/browse_indices.spec.ts",
        "!tests/flows/chart_builder.spec.ts",
        "!tests/flows/cleanup_review.spec.ts",
        "!tests/flows/cross_format_link.spec.ts",
        "!tests/flows/cross_format_prompts.spec.ts",
        "!tests/flows/discovery.spec.ts",
        "!tests/flows/fetch_summary.spec.ts",
        "!tests/flows/genres.spec.ts",
        "!tests/flows/hidden_formats.spec.ts",
        "!tests/flows/journal.spec.ts",
        "!tests/flows/landing.spec.ts",
        "!tests/flows/landing_bulk_edit.spec.ts",
        "!tests/flows/landing_inline_edit.spec.ts",
        "!tests/flows/landing_series_stacks.spec.ts",
        "!tests/flows/library_filters.spec.ts",
        "!tests/flows/listen.spec.ts",
        "!tests/flows/logs.spec.ts",
        "!tests/flows/merge.spec.ts",
        "!tests/flows/metadata_edit.spec.ts",
        "!tests/flows/metadata_edit_search.spec.ts",
        "!tests/flows/mini-dock.spec.ts",
        "!tests/flows/not_found.spec.ts",
        "!tests/flows/pdf_reader.spec.ts",
        "!tests/flows/persistence.spec.ts",
        "!tests/flows/physical_collection.spec.ts",
        "!tests/flows/search-palette.spec.ts",
        "!tests/flows/search.spec.ts",
        "!tests/flows/settings.spec.ts",
        "!tests/flows/shelf_detail.spec.ts",
        "!tests/flows/shelf_gallery.spec.ts",
        "!tests/flows/shelves.spec.ts",
        "!tests/flows/shelves_index.spec.ts",
        "!tests/flows/stats.spec.ts",
        "!tests/flows/stats_household.spec.ts",
        "!tests/flows/suggestions.spec.ts",
        "!tests/flows/theme_toggle.spec.ts",
        "!tests/flows/thumbnails.spec.ts",
        "!tests/flows/user_menu.spec.ts",
        "!tests/flows/users.spec.ts",
        "!tests/flows/worker-status.spec.ts",
        "!tests/ios_glue/chapter_label.spec.ts",
        "!tests/ios_glue/page_curl.spec.ts",
        "!tests/ios_glue/restore_echo.spec.ts",
        "!tests/ios_glue/selection_rows.spec.ts",
        "!tests/ios_glue/selection_text.spec.ts",
        "!tests/ios_glue/spread_threshold.spec.ts"
      ],
      "plugins": ["./lint/specsUsePageObjects.grit"]
    }
  ],
  "plugins": ["./lint/awaitWebFirstAssertions.grit"]
}
