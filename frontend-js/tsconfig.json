{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@ladle/react": [
        "./types/ladle-react.d.ts"
      ]
    }
  },
  "include": [
    "src",
    ".ladle",
    "types",
    "vite.config.ts"
  ]
}
