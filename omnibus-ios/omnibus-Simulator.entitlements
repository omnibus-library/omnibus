<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- omnibus.entitlements plus CarPlay, for simulator builds only. The
	     simulator's CarPlay window lists only apps carrying the CarPlay audio
	     entitlement, and its ad-hoc signing needs no profile to grant it;
	     a device build would fail to sign with it until Apple approves the
	     entitlement for this team. Keep the rest in step with
	     omnibus.entitlements. -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.omnibus.mobile</string>
	</array>
</dict>
</plist>
