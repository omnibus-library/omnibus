  "components": [
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "The default action: quiet raised fill, sinks 1px on press.",
      "html": "<button class=\"ds-btn\">Add to shelf</button>",
      "css": ".ds-btn{height:36px;padding:0 14px;border-radius:10px;background:var(--bg-2);color:var(--ink-0);border:1px solid var(--line-2);font:500 13px var(--sans);cursor:pointer;transition:background .15s,border-color .15s,transform .12s}.ds-btn:hover{background:var(--bg-3);border-color:var(--line)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one primary action on a screen.",
      "html": "<button class=\"ds-btn-primary\">Resume reading</button>",
      "css": ".ds-btn-primary{height:36px;padding:0 14px;border-radius:10px;background:var(--accent);color:var(--accent-ink);border:1px solid transparent;font:600 13px var(--sans);cursor:pointer;transition:background .15s,transform .12s}.ds-btn-primary:hover{background:color-mix(in oklch,var(--accent) 88%,white)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary actions that should recede.",
      "html": "<button class=\"ds-btn-ghost\">Cancel</button>",
      "css": ".ds-btn-ghost{height:36px;padding:0 14px;border-radius:10px;background:transparent;color:var(--ink-1);border:1px solid transparent;font:500 13px var(--sans);cursor:pointer;transition:background .15s,color .15s}.ds-btn-ghost:hover{background:var(--bg-1);color:var(--ink-0)}.ds-btn-ghost:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Filters and tags; selected swaps to an amber border.",
      "html": "<span class=\"ds-chip\">Fantasy <b>42</b></span> <span class=\"ds-chip on\">Sci-fi <b>17</b></span>",
      "css": ".ds-chip{display:inline-flex;gap:6px;align-items:center;padding:4px 10px;border-radius:999px;background:var(--bg-2);color:var(--ink-1);border:1px solid var(--line-2);font:12px var(--sans);transition:color .15s,border-color .15s}.ds-chip b{font:10px var(--mono);color:var(--ink-3)}.ds-chip:hover,.ds-chip.on{color:var(--ink-0);border-color:var(--accent)}"
    },
    {
      "name": "Field",
      "kind": "input",
      "refersTo": "input",
      "description": "In-app text field with an amber focus.",
      "html": "<label class=\"ds-field\"><span>Shelf name</span><input value=\"Summer reading\"></label>",
      "css": ".ds-field{display:grid;gap:6px;font:500 .875rem var(--sans);color:var(--ink-2)}.ds-field input{background:var(--bg-1);color:var(--ink-0);border:1px solid var(--line-2);border-radius:8px;padding:.55rem .75rem;font:.95rem var(--sans)}.ds-field input:focus{outline:2px solid color-mix(in oklch,var(--accent) 55%,transparent);outline-offset:1px;border-color:var(--accent)}"
    },
    {
      "name": "Nav Link",
      "kind": "nav",
      "refersTo": "nav-link",
      "description": "Top-bar destinations in mono uppercase pills.",
      "html": "<nav class=\"ds-nav\"><a class=\"on\">Library</a><a>Authors</a><a>Series</a><a>Stats</a></nav>",
      "css": ".ds-nav{display:flex;gap:2px;background:color-mix(in oklch,var(--bg-0) 92%,transparent);padding:14px 28px;backdrop-filter:blur(10px)}.ds-nav a{padding:6px 10px;border-radius:999px;font:11px var(--mono);letter-spacing:.09em;text-transform:uppercase;color:var(--ink-1);cursor:pointer}.ds-nav a:hover{color:var(--ink-0);background:var(--bg-1)}.ds-nav a.on{color:var(--ink-0);background:var(--bg-2)}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Shelf-toned container with the soft card shadow.",
      "html": "<div class=\"ds-card\"><div class=\"ds-label\">Reading goal</div><p>12 of 30 books this year</p></div>",
      "css": ".ds-card{background:var(--bg-1);border:1px solid var(--line-2);border-radius:14px;padding:20px;box-shadow:0 1px 0 color-mix(in oklch,black 22%,transparent),0 10px 24px -14px color-mix(in oklch,black 45%,transparent);color:var(--ink-0);font:14px/1.45 var(--sans)}.ds-card:hover{border-color:var(--line)}.ds-label{font:500 10.5px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ink-2)}"
    },
    {
      "name": "Book Cover",
      "kind": "custom",
      "refersTo": "cover",
      "description": "Missing-cover plate with book corners, spine shade and a hover lift.",
      "html": "<div class=\"ds-cover\"><span class=\"a\">Ursula K. Le Guin</span><span class=\"t\">The Dispossessed</span></div>",
      "css": ".ds-cover{width:120px;aspect-ratio:2/3;display:flex;flex-direction:column;justify-content:space-between;padding:9% 8% 8%;box-sizing:border-box;border-radius:2px 4px 4px 2px;background:linear-gradient(90deg,rgba(0,0,0,.3),transparent 8px),var(--cover-fallback-bg);color:var(--cover-fallback-ink);filter:drop-shadow(0 18px 22px color-mix(in oklch,black 50%,transparent)) drop-shadow(0 2px 0 color-mix(in oklch,black 30%,transparent));transition:filter .25s ease,transform .35s cubic-bezier(.2,.7,.2,1)}.ds-cover:hover{transform:translateY(-5px) scale(1.015);filter:drop-shadow(0 28px 30px color-mix(in oklch,black 65%,transparent)) drop-shadow(0 2px 0 color-mix(in oklch,black 30%,transparent))}.ds-cover .a{font:600 8px var(--sans);letter-spacing:.22em;text-transform:uppercase;opacity:.82}.ds-cover .t{font:500 20px/1 var(--serif);letter-spacing:-.018em;text-wrap:balance}"
